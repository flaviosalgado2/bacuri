{
  "name": "app",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "preview:build": "nuxt build && node .output/server/index.mjs",
    "docker:dev": "docker compose up -d",
    "docker:preview": "docker compose down && NUXT_COMMAND=\"npm run preview:build\" NODE_ENV=production docker compose up -d --build",
    "docker:down": "docker compose down",
    "postinstall": "nuxt prepare",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nuxt/ui": "^4.11.0",
    "chart.js": "^4.5.1",
    "drizzle-orm": "^0.45.2",
    "nuxt": "^4.5.2",
    "nuxt-auth-utils": "^0.5.30",
    "pg": "^8.23.0",
    "vue": "^3.5.42",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^5.3.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.129",
    "@nuxt/test-utils": "^4.3.0",
    "@types/pg": "^8.23.1",
    "@vite-pwa/assets-generator": "^1.0.4",
    "@vite-pwa/nuxt": "^1.1.1",
    "drizzle-kit": "^0.31.10",
    "happy-dom": "^20.14.0",
    "vitest": "^4.1.11"
  }
}
